<ResourceDictionary
    x:Class="AntonioAguadoRovira.NINA.Rgbfocus.Options"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  Se muestra en NINA, en Opciones > Plugins. La clave debe ser <nombre del plugin>_Options (el nombre es el AssemblyTitle)  -->
    <DataTemplate x:Key="RGB HFR Analyzer_Options">
        <StackPanel Orientation="Vertical">
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Text="{Binding LanguageLabel}" />
                <ComboBox MinWidth="180" Margin="10,0,0,0" ItemsSource="{Binding LanguageOptions}" SelectedIndex="{Binding LanguageIndex}" />
            </StackPanel>
            <TextBlock Margin="0,6,0,0" Opacity="0.7" Text="{Binding RestartNote}" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
