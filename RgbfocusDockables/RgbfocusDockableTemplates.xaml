<ResourceDictionary
    x:Class="AntonioAguadoRovira.NINA.Rgbfocus.RgbfocusDockables.MyPluginDockableTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:alt="clr-namespace:NINA.WPF.Base.View;assembly=NINA.WPF.Base"
    xmlns:local="clr-namespace:AntonioAguadoRovira.NINA.Rgbfocus.RgbfocusDockables"
    xmlns:loc="clr-namespace:AntonioAguadoRovira.NINA.Rgbfocus.Localization"
    xmlns:mini="clr-namespace:NINA.View.Sequencer.MiniSequencer;assembly=NINA.Sequencer"
    xmlns:nina="clr-namespace:NINA.View.Sequencer;assembly=NINA.Sequencer"
    xmlns:util="clr-namespace:NINA.Core.Utility;assembly=NINA.Core">

    <!--  Iconos copiados de NINA (SVGDictionary.xaml) para que los botones sean iguales  -->
